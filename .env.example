# Copier vers .env (jamais versionné) puis remplir.
# Clés : https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (le secret diffère selon l'environnement)
PLAID_ENV=sandbox

# Requis seulement si l'institution utilise OAuth en Production.
# Doit être enregistré dans le tableau de bord Plaid (API > Allowed redirect URIs).
# PLAID_REDIRECT_URI=http://localhost:8765/oauth-return
